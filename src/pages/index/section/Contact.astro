 <section id="contact" class="glass-card">

            <p class="mb-4 text-sm font-black uppercase tracking-widest text-sky-600 dark:text-sky-300">
                03 / Get In Touch
            </p>

            <h2 class="mb-8 text-4xl font-black uppercase tracking-tight text-blue-800 dark:text-sky-300 md:text-5xl">
                Contact Me_
            </h2>

            <form id="contactForm" class="flex flex-col gap-6">

                <div>
                    <label for="name" class="mb-2 block font-black uppercase">
                        Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        class="w-full border-4 border-blue-800 bg-sky-50 px-4 py-3 font-bold text-blue-950 outline-none focus:bg-sky-200 dark:border-sky-300 dark:bg-blue-950 dark:text-white dark:focus:bg-blue-800">
                </div>

                <div>
                    <label for="email" class="mb-2 block font-black uppercase">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        class="w-full border-4 border-blue-800 bg-sky-50 px-4 py-3 font-bold text-blue-950 outline-none focus:bg-sky-200 dark:border-sky-300 dark:bg-blue-950 dark:text-white dark:focus:bg-blue-800">
                </div>

                <div>
                    <label for="message" class="mb-2 block font-black uppercase">
                        Message
                    </label>

                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        required
                        class="w-full resize-none border-4 border-blue-800 bg-sky-50 px-4 py-3 font-bold text-blue-950 outline-none focus:bg-sky-200 dark:border-sky-300 dark:bg-blue-950 dark:text-white dark:focus:bg-blue-800"></textarea>
                </div>

                <button type="submit" class="btn-primary w-full">
                    Send Message →
                </button>

            </form>

            <p id="formMessage" class="mt-4 font-bold" aria-live="polite"></p>

        </section>

    </main>